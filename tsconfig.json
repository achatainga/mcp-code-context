{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "web-tree-sitter": ["node_modules/web-tree-sitter/web-tree-sitter.d.ts"]
    }
  },
  "include": [
    "src/**/*",
    "tests/test-v3-smoke.ts",
    "tests/test-all-parsers.ts",
    "tests/test-write-ops.ts",
    "tests/test-wasm.ts",
    "tests/test-ts-wasm.ts",
    "tests/test-wasm-parsers.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-v3"]
}
